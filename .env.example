# Keep credentials only in your local .env file. Never commit API keys.
LOAF_API_KEY=
LOAF_USER_ID=
LOAF_API_BASE_URL=https://api.loafmarkets.com/api
LOAF_TARGET_TOKEN=terafab

# Optional local paths. Relative paths are resolved from the repository root.
LOAF_DB_PATH=.state/loaf_bot.sqlite3
LOAF_LOG_DIR=logs
